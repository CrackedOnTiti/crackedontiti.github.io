---
import type { GetStaticPaths } from 'astro';
import { Image, Picture } from 'astro:assets';
import { widthsFor } from '../../lib/media';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Stack from '../../components/Stack.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { teamLabel, writeupHref } from '../../lib/format';

// Detail pages exist for featured projects, and for others marked `writeup: true`.
// Featured body (Markdown): Problem → What I built → How it works (inline SVG diagram) → Results.
// "Seen running" (frontmatter media) and Links are added here.
export const getStaticPaths = (async () => {
  const withPage = await getCollection('projects', (p) => writeupHref(p.data) !== null);
  return withPage.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const hasLinks = Object.values(p.links).some(Boolean);
const code = p.closedSource === 'proprietary' ? 'Proprietary: no public code' : p.closedSource === 'private' ? 'Private repository' : null;
---
<Base title={p.title} description={p.summary}>
  <article class="wrap detail">
    <p class="mono back"><a href="/#work">All selected work</a></p>
    <header class="head">
      {p.logo && <Image class="logo" src={p.logo} alt="" widths={[128, 256]} sizes="8rem" format="webp" decoding="async" />}
      <h1>{p.title}</h1>
      <p class="summary">{p.summary}</p>
      <dl class="facts mono">
        <div><dt>Role</dt><dd>{p.role}</dd></div>
        {teamLabel(p.team) && <div><dt>Team</dt><dd>{teamLabel(p.team)}</dd></div>}
        <div><dt>When</dt><dd>{p.period}</dd></div>
        {code && <div><dt>Code</dt><dd>{code}</dd></div>}
      </dl>
      <Stack items={p.stack} />
    </header>
    {p.cover && (
      <Picture
        class="cover"
        src={p.cover.image}
        alt={p.cover.alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={widthsFor(p.cover.image, [640, 1000, 1600])}
        sizes="(min-width: 60rem) 52rem, 100vw"
        decoding="async"
      />
    )}
    <div class="prose">
      <Content />
      {p.media.length > 0 && (
        <>
          <h2 id="media">{p.mediaHeading}</h2>
          <ProjectMedia project={project} />
        </>
      )}
      {hasLinks && (
        <>
          <h2>Links</h2>
          <ProjectLinks project={project} showClosed={false} />
        </>
      )}
    </div>
  </article>
</Base>

<style>
  .detail { padding-block: var(--space-l) 0; display: grid; gap: var(--space-xl); }
  .back a { color: var(--text-muted); }
  .back a::before { content: '← '; }
  .head { display: grid; gap: var(--space-m); max-width: 52rem; }
  .detail :global(.cover) { display: block; width: 100%; max-width: 52rem; height: auto; border: 1px solid var(--rule-strong); }
  .head :global(.logo) { width: auto; height: 5rem; }
  h1 { font-size: var(--step-hero); line-height: 0.95; letter-spacing: -0.035em; font-weight: 800; }
  .summary { font-size: var(--step-1); line-height: var(--leading-snug); max-width: 44ch; }
  .facts { display: grid; gap: var(--space-2xs); }
  .facts div { display: grid; grid-template-columns: 4.5rem 1fr; gap: var(--space-s); }
  .facts dt { color: var(--text-faint); }
  .facts dd { margin: 0; color: var(--text-muted); }

  .prose { max-width: var(--measure); }
  .prose :global(h2) {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: var(--step-1); margin-top: var(--space-l); margin-bottom: var(--space-2xs); }
  .prose :global(p + p), .prose :global(ul + p), .prose :global(p + ul) { margin-top: var(--space-s); }
  .prose :global(ul) { padding-left: 1.1em; display: grid; gap: var(--space-2xs); }
  .prose :global(strong) { font-weight: 600; }

</style>
