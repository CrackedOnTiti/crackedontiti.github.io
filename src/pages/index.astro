---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TabBar, { type Tab } from '../components/TabBar.astro';
import AboutPanel from '../components/AboutPanel.astro';
import WorkPanel from '../components/WorkPanel.astro';
import SecurityPanel from '../components/SecurityPanel.astro';
import ExperiencePanel from '../components/ExperiencePanel.astro';
import ContactPanel from '../components/ContactPanel.astro';

// Order and ids must match the panels below; the ids are the URL hashes (#work).
const tabs: Tab[] = [
  { id: 'about', label: 'About' },
  { id: 'work', label: 'Work' },
  { id: 'security', label: 'Security' },
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact' },
];
---
<Base>
  <Hero />
  <TabBar tabs={tabs} />
  <AboutPanel />
  <WorkPanel />
  <SecurityPanel />
  <ExperiencePanel />
  <ContactPanel />
</Base>

<script src="../scripts/site.ts"></script>
