---
// Expandable featured project. Without JavaScript every panel is open. With it (src/scripts/site.ts),
// one panel is open at a time and the height animates via grid-template-rows 0fr → 1fr.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import MediaSlot from './MediaSlot.astro';
import ProjectFacts from './ProjectFacts.astro';
import { renderDiagram } from '../diagrams/render.mjs';
import { specs } from '../diagrams/specs.mjs';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Open when the script first runs. */
  open?: boolean;
}
const { project, open = false } = Astro.props;
const p = project.data;
const panelId = `project-${p.slug}`;
const diagramSpec = p.panelDiagram ? (specs as Record<string, { title: string }>)[p.panelDiagram] : undefined;
if (p.panelDiagram && !diagramSpec) throw new Error(`${p.slug}: unknown panelDiagram "${p.panelDiagram}"`);
// Build-time SVG from our own spec file (real text, no inline styles): safe for set:html.
const diagram = diagramSpec ? renderDiagram(diagramSpec) : null;
---
<article class="row" data-expander data-default-open={open ? '' : undefined}>
  <h3 class="row-h">
    <button type="button" class="toggle" aria-expanded="true" aria-controls={panelId} data-expander-toggle>
      <span class:list={['badge', { 'badge--logo': p.logo }]} aria-hidden="true">
        {p.logo ? <Image src={p.logo} alt="" widths={[64, 128]} sizes="4rem" format="webp" loading="lazy" decoding="async" /> : p.monogram}
      </span>
      <span class="titles">
        <span class="label label--red tag">{p.tag}</span>
        <span class="title">{p.title}</span>
        <span class="tagline">{p.tagline}</span>
      </span>
      <span class="arrow" aria-hidden="true">‹</span>
    </button>
  </h3>
  <div class="panel" id={panelId} data-expander-panel>
    <div class="clip">
      <div class="body">
        <div class="main">
          <p class="intro">{p.intro}</p>
          <h4 class="label sub">How it works</h4>
          <ol class="flow" role="list">
            {p.flow.map((step, i) => (
              <li class:list={{ first: i === 0 }}>
                {typeof step === 'string' ? (
                  <span class="chip">{step}</span>
                ) : (
                  <span class="chip chip--detail"><span class="chip-title">{step.title}</span><span class="chip-detail">{step.detail}</span></span>
                )}
              </li>
            ))}
          </ol>
          {p.flowNote && <p class="flow-note">{p.flowNote}</p>}
          {diagram && diagramSpec && (
            <>
              <h4 class="label sub">{diagramSpec.title}</h4>
              <div class="panel-diagram" set:html={diagram} />
            </>
          )}
          <h4 class="label sub">What I did</h4>
          <ul class="did">
            {p.highlights.map((d) => <li>{d}</li>)}
          </ul>
        </div>
        <div class="side">
          <MediaSlot project={project} />
          <ProjectFacts project={project} />
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .row { border-top: 1px solid var(--rule); }
  .row-h { font: inherit; }
  .toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    padding-block: 1.75rem;
    background: none;
    border: 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .toggle:focus-visible { outline-offset: 2px; }
  .badge {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--rule-strong);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .titles { flex: 1 1 auto; min-width: 0; display: grid; }
  .title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 1.05;
  }
  .tagline { margin-top: 0.375rem; color: var(--text-muted); }
  .arrow {
    flex: 0 0 auto;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--text-faint);
    transition: transform 300ms var(--ease), color var(--dur) var(--ease);
  }
  .badge--logo { padding: 0.375rem; }
  .badge--logo :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .row:not([data-ready]) .arrow, .row:not([data-ready]) .badge { transition: none; }
  .toggle:hover .title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.12em; }
  .toggle[aria-expanded='true'] .badge { border-color: var(--red); color: var(--red-text); }
  .toggle[aria-expanded='true'] .arrow { color: var(--red-text); transform: rotate(-90deg); }

  /* Without the script the toggle does nothing: no arrow, no pointer. */
  :global(html:not(.js)) .arrow { display: none; }
  :global(html:not(.js)) .toggle { cursor: default; }
  :global(html:not(.js)) .toggle:hover .title { text-decoration: none; }

  .panel { display: grid; grid-template-rows: 1fr; }
  .panel[data-open='false'] { grid-template-rows: 0fr; visibility: hidden; }
  /* data-ready is set by the script after the first state, so nothing animates on load.
     visibility flips at the end of a close and at the start of an open. */
  .row[data-ready] .panel { transition: grid-template-rows var(--dur-panel) var(--ease), visibility 0s; }
  .row[data-ready] .panel[data-open='false'] {
    transition: grid-template-rows var(--dur-panel) var(--ease), visibility 0s var(--dur-panel);
  }
  .clip { overflow: hidden; min-height: 0; }
  .body { display: flex; flex-wrap: wrap; gap: var(--space-l); padding-bottom: 3rem; }
  .main { flex: 999 1 35rem; min-width: 0; }
  .side { flex: 1 1 18.75rem; display: flex; flex-direction: column; gap: var(--space-s); }
  .intro { font-size: 1.125rem; }
  .sub { margin-top: 1.75rem; }
  .flow {
    margin-top: var(--space-xs);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }
  .flow li {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--step--1);
  }
  .flow li::before {
    content: '→';
    color: var(--text-faint);
    font-family: var(--font-mono);
  }
  .flow li.first::before { content: none; }
  .chip {
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    padding: 0.5rem 0.75rem;
  }
  .first .chip { border-color: var(--red); }
  .chip--detail { display: grid; gap: 0.15rem; max-width: 15rem; }
  .chip-title { font-weight: 500; }
  .chip-detail { font-family: var(--font-mono); font-size: var(--step--2); color: var(--text-faint); line-height: 1.4; }
  .panel-diagram :global(.diagram) { margin-block: var(--space-xs) 0; }
  .flow-note { margin-top: var(--space-xs); font-size: var(--step--1); color: var(--text-faint); max-width: 40rem; }
  .did { margin-top: var(--space-xs); padding-left: 1.25rem; color: var(--text-muted); }
  .did li + li { margin-top: 0.375rem; }

  @media (min-width: 48rem) {
    .badge { width: 4rem; height: 4rem; font-size: 1.25rem; }
  }
</style>
