---
import Panel from './Panel.astro';
import { security } from '../data/profile';
---
<Panel id="security" heading="Security work">
  <div class="cases">
    {security.cases.map((c, i) => (
      <article class="case" aria-labelledby={`case-${i + 1}`}>
        <p class="case-meta label">
          <span class="label--red">Case {String(i + 1).padStart(2, '0')}</span>
          <span>{c.kind}</span>
        </p>
        <h3 id={`case-${i + 1}`} class="case-title">
          {c.href ? <a href={c.href}>{c.title}</a> : c.title}
        </h3>
        <dl class="sar">
          <dt class="label">Situation</dt><dd>{c.situation}</dd>
          <dt class="label">Action</dt><dd>{c.action}</dd>
          <dt class="label">Result</dt><dd class="result">{c.result}</dd>
        </dl>
      </article>
    ))}
  </div>

  <ul class="strip" role="list">
    {security.strip.map((s) => (
      <li>
        <p class="big">{s.big}</p>
        <p class="small">{s.href ? <a href={s.href}>{s.small}</a> : s.small}</p>
      </li>
    ))}
  </ul>

  <div class="training">
    <h3 class="label">My main cybersec training tools</h3>
    <ul class="platforms" role="list">
      {security.platforms.map((pl) => {
        const inner = (
          <>
            <span class="logo" aria-hidden="true"></span>
            <span>
              <span class="pl-name">{pl.name}</span>
              <span class="pl-focus">{pl.focus}</span>
            </span>
          </>
        );
        return <li>{pl.profile ? <a class="platform" href={pl.profile}>{inner}</a> : <div class="platform">{inner}</div>}</li>;
      })}
    </ul>
  </div>
</Panel>

<style>
  .cases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(30rem, 100%), 1fr));
    gap: var(--space-m);
  }
  .case {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: var(--space-m);
  }
  .case-meta { display: flex; justify-content: space-between; gap: var(--space-xs); flex-wrap: wrap; }
  .case-title { font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.625rem); line-height: 1.15; }
  .case-title a { color: inherit; text-decoration-color: var(--rule-strong); }
  .case-title a:hover { text-decoration-color: var(--red); }
  .sar {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.625rem var(--space-s);
    font-size: 0.9375rem;
  }
  .sar dt { padding-top: 0.2rem; }
  .sar dd { margin: 0; color: var(--text-muted); }
  .sar dd.result { color: var(--text); }

  .strip {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13.75rem, 100%), 1fr));
    border-top: 1px solid var(--rule);
    list-style: none;
    padding: 0;
  }
  .strip li { padding: var(--space-m) var(--space-m) var(--space-m) 0; border-bottom: 1px solid var(--rule); }
  .big { font-family: var(--font-display); font-weight: 800; font-size: 2.125rem; line-height: 1.2; }
  .small { font-size: var(--step--1); color: var(--text-faint); }

  .training { margin-top: 3rem; }
  .platforms {
    margin-top: var(--space-s);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13.75rem, 100%), 1fr));
    gap: var(--space-s);
    list-style: none;
    padding: 0;
  }
  .platform {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 1.25rem;
    color: var(--text);
    text-decoration: none;
  }
  a.platform:hover { border-color: var(--text-faint); }
  /* Neutral slot: official badges to come. No platform logos are drawn here. */
  .logo { flex: 0 0 auto; width: 3rem; height: 3rem; border: 1px dashed var(--rule-strong); }
  .pl-name { display: block; font-family: var(--font-display); font-weight: 700; }
  .pl-focus { display: block; font-size: 0.8125rem; color: var(--text-faint); }

  @media (min-width: 48rem) {
    .case { padding: 2rem; }
  }
</style>
