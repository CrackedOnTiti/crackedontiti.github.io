---
// layout="rail": label column on the left at wide sizes. layout="wide": heading above, full width.
interface Props {
  id: string;
  label: string;
  lede?: string;
  layout?: 'rail' | 'wide';
}
const { id, label, lede, layout = 'rail' } = Astro.props;
const headingId = `${id}-heading`;
---
<section id={id} class:list={['section', 'wrap', `section--${layout}`]} aria-labelledby={headingId}>
  <header class="head">
    <h2 id={headingId}>{label}</h2>
    {lede && <p class="lede">{lede}</p>}
  </header>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    gap: var(--space-l);
    padding-top: var(--space-2xl);
  }
  h2 {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .lede {
    color: var(--text-muted);
    max-width: 46ch;
    margin-top: var(--space-2xs);
  }
  .body { min-width: 0; }

  .section--wide h2 { font-size: var(--step-3); letter-spacing: -0.03em; }

  @media (min-width: 60rem) {
    .section--rail {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .section--rail .head { position: sticky; top: var(--space-l); align-self: start; }
    .section--rail h2 { font-size: var(--step-1); }
    .section--rail .lede { font-size: var(--step--1); }
    .section--wide .head {
      display: grid;
      grid-template-columns: var(--rail) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: baseline;
    }
    .section--wide .lede { margin-top: 0; }
  }
</style>
