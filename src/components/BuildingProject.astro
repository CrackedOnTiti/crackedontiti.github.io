---
// "Building now" entry: short by default. Summary, required note, stack and links stay visible;
// the longer write-up folds into a native <details> (no JavaScript).
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import ProjectLinks from './ProjectLinks.astro';
import ProjectScreenshot from './ProjectScreenshot.astro';
import Stack from './Stack.astro';
import { teamLabel } from '../lib/format';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());
---
<article class="building" aria-labelledby={`b-${p.slug}`}>
  <h3 id={`b-${p.slug}`}>{p.title}</h3>
  <p class="mono meta">{[p.period, teamLabel(p.team)].filter(Boolean).join(' · ')}</p>
  <p class="summary">{p.summary}</p>
  {p.note && <p class="note">{p.note}</p>}
  <ProjectScreenshot project={project} />
  <Stack items={p.stack} />
  <ProjectLinks project={project} />
  {hasBody && (
    <details>
      <summary class="mono">More about {p.title}</summary>
      <div class="prose"><Content /></div>
    </details>
  )}
</article>

<style>
  .building {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }
  h3 { font-size: var(--step-1); }
  .meta { color: var(--text-faint); }
  .summary { max-width: var(--measure); }
  .note {
    font-size: var(--step--1);
    color: var(--text-muted);
    border-left: 2px solid var(--rule-strong);
    padding-left: var(--space-xs);
  }
  details { margin-top: var(--space-3xs); }
  summary {
    cursor: pointer;
    color: var(--text-muted);
    width: fit-content;
    list-style-position: outside;
    margin-left: 1em;
  }
  summary:hover { color: var(--text); }
  .prose {
    color: var(--text-muted);
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
    max-width: var(--measure);
  }
</style>
