---
import { getCollection, getEntry, render } from 'astro:content';
import { byOrder } from '../lib/format';

const roles = (await getCollection('experience')).sort(byOrder);
const items = await Promise.all(
  roles.map(async (r) => ({
    r,
    Content: (await render(r)).Content,
    project: r.data.project ? await getEntry(r.data.project) : undefined,
  })),
);
---
<ol class="roles">
  {items.map(({ r, Content, project }) => (
    <li class="role">
      <p class="mono meta">{[r.data.period, r.data.location].filter(Boolean).join(' · ')}</p>
      <div class="main">
        <h3>{r.data.role}<span class="org">, {r.data.org}</span></h3>
        <p class="summary">{r.data.summary}</p>
        <div class="body"><Content /></div>
        {project && (
          <p class="mono"><a href={`/projects/${project.data.slug}/`}>{project.data.title} write-up</a></p>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .roles { list-style: none; padding: 0; display: grid; }
  .role {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-m);
    border-top: 1px solid var(--rule);
  }
  .role:first-child { border-top: 0; padding-top: 0; }
  .meta { color: var(--text-faint); }
  .main { display: grid; gap: var(--space-2xs); max-width: var(--measure); }
  h3 { font-size: var(--step-1); }
  .org { color: var(--text-muted); font-weight: 500; }
  .summary { color: var(--text-muted); }
  .body :global(ul) { padding-left: 1.1em; display: grid; gap: var(--space-2xs); }
  .body :global(li::marker) { color: var(--text-faint); }
  .body :global(strong) { font-weight: 600; }

  @media (min-width: 48rem) {
    .role { grid-template-columns: 9.5rem minmax(0, 1fr); gap: var(--space-l); }
    .meta { padding-top: 0.25rem; }
  }
</style>
