---
// Responsive, lazy-loaded screenshot (AVIF/WebP at build time). Alt text comes from frontmatter.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const p = Astro.props.project.data;
---
{p.screenshot && p.screenshotAlt && (
  <figure class="shot">
    <Picture
      src={p.screenshot}
      alt={p.screenshotAlt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes="(min-width: 60rem) 30rem, 100vw"
      loading="lazy"
      decoding="async"
    />
    {p.screenshotCaption && <figcaption class="mono">{p.screenshotCaption}</figcaption>}
  </figure>
)}

<style>
  .shot { margin: var(--space-2xs) 0; }
  .shot :global(img) { width: 100%; height: auto; border: 1px solid var(--rule-strong); }
  figcaption { color: var(--text-faint); margin-top: var(--space-2xs); }
</style>
