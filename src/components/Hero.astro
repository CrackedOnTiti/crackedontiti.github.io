---
import { Picture } from 'astro:assets';
import portrait from '../assets/brand/portrait.jpg';
import { site } from '../lib/site';
import { hero } from '../data/profile';
---
<section class="hero wrap" aria-labelledby="hero-name">
  <div class="id">
    <p class="label label--red kicker">{hero.kicker}</p>
    <h1 id="hero-name" class="name">Thierry<br />Bungaroo</h1>
    <p class="intro">{hero.intro}</p>
    <ul class="proof" role="list" aria-label="Highlights">
      {hero.proof.map((p) => <li>{p}</li>)}
    </ul>
  </div>
  <figure class="portrait">
    <div class="frame">
      <Picture
        src={portrait}
        alt={`Portrait of ${site.name}`}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        width={726}
        height={908}
        widths={[360, 560, 726]}
        sizes="(min-width: 60rem) 25rem, calc(100vw - 4rem)"
        fit="cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <figcaption class="label">{hero.caption}</figcaption>
  </figure>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-l) 3.5rem;
    padding-block: var(--space-l) var(--space-xl);
  }
  .id { flex: 999 1 35rem; min-width: 0; }
  .kicker { font-size: 0.8125rem; margin-bottom: 1.25rem; }
  .name {
    font-size: var(--step-hero);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-wrap: initial;
  }
  .intro {
    margin-top: 2rem;
    max-width: 38.75rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text-muted);
  }
  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }
  .proof li {
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: var(--step--1);
    line-height: 1.4;
  }

  /* Portrait with the red frame offset down-right. Natural colours, no filter. */
  .portrait {
    flex: 1 1 20rem;
    /* Leaves room for the frame's 20px offset inside the gutter. */
    max-width: min(25rem, calc(100% - 1.25rem));
  }
  .frame { position: relative; }
  .frame::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1px solid var(--red);
  }
  .frame :global(img) {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  figcaption { margin-top: 2rem; text-transform: none; letter-spacing: 0.02em; }

  @media (min-width: 48rem) {
    .hero { padding-block: 4.5rem 3.5rem; }
  }
</style>
