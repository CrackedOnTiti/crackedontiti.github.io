---
import { site } from '../lib/site';

// Evidence on the first screen. Each line is from CONTENT_BRIEF and links to its write-up.
const proof = [
  {
    href: '/projects/sentinel/',
    text: 'Lead developer on Sentinel, ML network threat detection for SMEs',
    note: 'Internship, Interface Numérique',
  },
  {
    href: '/projects/rift-rewind/',
    text: 'Won the Roast Master 3000 Prize ($1,000) with Rift Rewind',
    note: 'AWS × Riot Games hackathon',
  },
  {
    href: '/projects/vigilansee/',
    text: 'Building VigilanSee, server-side behavioural anti-cheat',
    note: 'Epitech end-of-studies project, team of 4',
  },
];
---
<section class="hero wrap" aria-labelledby="hero-name">
  <div class="top">
    <div class="id">
      <p class="mono kicker">Cybersecurity · Epitech Toulouse · on exchange at BIT Beijing</p>
      <h1 id="hero-name" class="name">
        <span>Thierry</span>
        <span>Bungaroo</span>
      </h1>
    </div>

    <ul class="proof" aria-label="Highlights">
      {proof.map((p) => (
        <li>
          <a href={p.href}>{p.text}</a>
          <span class="mono">{p.note}</span>
        </li>
      ))}
    </ul>
  </div>

  <dl class="facts">
    <div class="fact fact--key">
      <dt class="mono">Looking for</dt>
      <dd>Epitech 5th-year internship, part-time then full-time, after June&nbsp;2027</dd>
    </div>
    <div class="fact">
      <dt class="mono">Interests</dt>
      <dd>Pentesting, detection / SOC, systems, applied ML</dd>
    </div>
    <div class="fact">
      <dt class="mono">Where</dt>
      <dd>Toulouse, Paris, Lille, Castres or remote</dd>
    </div>
  </dl>

  <ul class="links mono">
    <li><a href="#contact">Contact form</a></li>
    <li><a href={site.links.linkedin} rel="me">LinkedIn</a></li>
    <li><a href={site.links.github} rel="me">GitHub</a></li>
  </ul>
</section>

<style>
  .hero {
    padding-block: var(--space-l) var(--space-m);
    display: grid;
    gap: var(--space-l);
  }
  .top { display: grid; gap: var(--space-l); }
  .kicker { color: var(--text-muted); margin-bottom: var(--space-s); }
  .name {
    font-size: var(--step-hero);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.035em;
    display: flex;
    flex-direction: column;
  }
  .name span:last-child { color: var(--text-muted); }

  .proof {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-s);
    max-width: 34rem;
  }
  .proof li { display: grid; gap: 0.15rem; }
  .proof a {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    text-decoration-color: var(--rule-strong);
  }
  .proof a:hover { text-decoration-color: var(--red); }
  .proof .mono { color: var(--text-faint); }

  .facts {
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }
  .fact { display: grid; gap: var(--space-3xs); }
  .fact dt { color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.08em; }
  .fact dd { margin: 0; }
  .fact--key { border-left: 3px solid var(--red); padding-left: var(--space-s); }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 48rem) {
    .facts { grid-template-columns: 1.4fr 1fr 1fr; gap: var(--space-l); }
  }
  @media (min-width: 60rem) {
    .hero { padding-top: var(--space-xl); }
    .top {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--space-xl);
    }
    .proof { padding-bottom: 0.4rem; }
  }
</style>
