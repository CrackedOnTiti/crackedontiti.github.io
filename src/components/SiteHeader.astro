---
import { site } from '../lib/site';
import Raven from './Raven.astro';
---
<header class="site-header wrap">
  <a class="brand" href="/" aria-label={`${site.name}, home`}>
    <Raven size="small" />
    <span class="brand-name">CRACKEDONTITI.DEV</span>
  </a>
  <ul class="ext" role="list">
    <li><a href={site.links.linkedin} rel="me">LinkedIn<span aria-hidden="true">↗</span></a></li>
    <li><a href={site.links.github} rel="me">GitHub<span aria-hidden="true">↗</span></a></li>
  </ul>
</header>

<style>
  .site-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    padding-top: var(--space-m);
  }
  .brand {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    gap: var(--space-xs);
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }
  .brand:hover .brand-name { color: var(--text); }
  .ext {
    display: flex;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .ext a { display: inline-flex; align-items: center; gap: 0.3em; min-height: 2.75rem; text-decoration: none; }
  .ext a:hover { text-decoration: underline; }

  @media (min-width: 48rem) {
    .site-header { padding-top: 2rem; }
  }
</style>
