---
import { Image } from 'astro:assets';
import { site } from '../lib/site';
// LinkedIn's official white [in] bug (brand.linkedin.com download, unmodified): LinkedIn allows
// only blue, black or white, so it does not take the link colour. GitHub: the simple-icons
// Invertocat in white, for the same reason (GitHub asks that its logo colour not be changed).
import inBug from '../assets/brands/linkedin-inbug-white.png';
import Raven from './Raven.astro';
---
<header class="site-header wrap">
  <a class="brand" href="/" aria-label={`${site.name}, home`}>
    <Raven size="small" />
    <span class="brand-name">CRACKEDONTITI.DEV</span>
  </a>
  <ul class="ext" role="list">
    <li>
      <a href={site.links.linkedin} rel="me">
        <Image class="ext-icon" src={inBug} alt="" aria-hidden="true" widths={[16, 32, 48]} sizes="15px" loading="eager" decoding="async" />
        LinkedIn<span aria-hidden="true"> ↗</span>
      </a>
    </li>
    <li>
      <a href={site.links.github} rel="me">
        <img class="ext-icon" src="/brands/github.svg" alt="" aria-hidden="true" width="16" height="16" decoding="async" />
        GitHub<span aria-hidden="true"> ↗</span>
      </a>
    </li>
  </ul>
</header>

<style>
  .site-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    padding-top: var(--space-m);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }
  .brand:hover .brand-name { color: var(--text); }
  .ext {
    display: flex;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .ext a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem; /* 44px touch target */
    text-decoration: none;
  }
  .ext :global(.ext-icon) { flex: 0 0 auto; width: auto; height: 0.9375rem; }
  .ext a:hover { text-decoration: underline; }

  @media (min-width: 48rem) {
    .site-header { padding-top: 2rem; }
  }
</style>
