---
import type { CollectionEntry } from 'astro:content';
import { statsFor, STAR_THRESHOLD } from '../lib/github';

interface Props {
  project: CollectionEntry<'projects'>;
  /** "Private repository" / "Proprietary" note. Off where the page shows it elsewhere. */
  showClosed?: boolean;
}
const { project, showClosed = true } = Astro.props;
const p = project.data;
const stats = statsFor(p.links.repo);
const labels: Record<string, string> = { repo: 'Repository', docs: 'Docs', devpost: 'Devpost', devlogs: 'Devlogs', video: 'Submission video' };
const links = Object.entries(p.links).filter((e): e is [string, string] => Boolean(e[1]));
const notes = [
  showClosed && p.closedSource ? closedLabel(p.closedSource) : null,
  stats && stats.stars >= STAR_THRESHOLD ? `${stats.stars} stars` : null,
].filter((n): n is string => Boolean(n));

function closedLabel(kind: 'private' | 'proprietary') {
  return kind === 'private' ? 'Private repository' : 'Proprietary: no public code';
}
---
{(links.length > 0 || notes.length > 0) && (
  <ul class="links mono">
    {links.map(([k, href]) => (
      <li><a href={href}>{labels[k] ?? k}<span class="visually-hidden">: {p.title}</span></a></li>
    ))}
    {notes.map((n) => <li class="note">{n}</li>)}
  </ul>
)}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    list-style: none;
    padding: 0;
  }
  .note { color: var(--text-faint); }
</style>
