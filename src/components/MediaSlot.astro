---
// Screenshot if the project has one; otherwise a neutral placeholder describing what will go there.
import type { CollectionEntry } from 'astro:content';
import ProjectScreenshot from './ProjectScreenshot.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
---
{p.screenshot ? (
  <ProjectScreenshot project={project} />
) : (
  <div class="slot" role="img" aria-label={`Placeholder for ${p.title} media: ${p.mediaPlaceholder ?? 'screenshot to come'}`}>
    <span aria-hidden="true">[ {p.mediaPlaceholder ?? 'screenshot to come'} ]</span>
  </div>
)}

<style>
  .slot {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-s);
    text-align: center;
    background: repeating-linear-gradient(135deg, var(--surface) 0 10px, var(--surface-2) 10px 20px);
    border: 1px dashed var(--rule-strong);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-faint);
  }
</style>
