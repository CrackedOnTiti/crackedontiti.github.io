---
import type { CollectionEntry } from 'astro:content';
import ProjectLinks from './ProjectLinks.astro';
import Stack from './Stack.astro';
import { teamLabel } from '../lib/format';

interface Props {
  project: CollectionEntry<'projects'>;
  lead?: boolean;
}
const { project, lead = false } = Astro.props;
const p = project.data;
const href = `/projects/${p.slug}/`;
---
<article class:list={['featured', { 'featured--lead': lead }]} aria-labelledby={`f-${p.slug}`}>
  <p class="mono meta">
    <span>{p.period}</span>
    {teamLabel(p.team) && <span>{teamLabel(p.team)}</span>}
  </p>
  <div class="main">
    <h3 id={`f-${p.slug}`}><a href={href}>{p.title}</a></h3>
    <p class="role">{p.role}</p>
    <p class="summary">{p.summary}</p>
    <Stack items={p.stack} />
    <div class="foot">
      <a class="mono more" href={href} aria-label={`Read the ${p.title} write-up`}>Read the write-up</a>
      <ProjectLinks project={project} />
    </div>
  </div>
</article>

<style>
  .featured {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-l);
    border-top: 1px solid var(--rule);
  }
  .meta { color: var(--text-faint); display: flex; flex-wrap: wrap; gap: 0 var(--space-s); }
  .main { display: grid; gap: var(--space-xs); max-width: 44rem; }
  h3 { font-size: var(--step-3); letter-spacing: -0.03em; line-height: var(--leading-tight); }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .featured--lead h3 { font-size: clamp(2.2rem, 1.6rem + 3vw, 3.75rem); }
  .role { color: var(--text-muted); }
  .summary { max-width: var(--measure); }
  .featured--lead .summary { font-size: var(--step-1); line-height: var(--leading-snug); }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    align-items: baseline;
    margin-top: var(--space-2xs);
  }
  .more::after { content: ' →'; }

  @media (min-width: 60rem) {
    .featured {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .meta { flex-direction: column; padding-top: 0.9rem; }
  }
</style>
