---
// "Open full page" icon link to a project's write-up. A plain link: works without JavaScript.
// The visible tooltip shows on hover and on keyboard focus; the accessible name comes from aria-label.
interface Props {
  href: string;
  title: string;
}
const { href, title } = Astro.props;
const label = `Open the full ${title} page`;
---
<a class="full" href={href} aria-label={label}>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
    <path d="M14 4h6v6" />
    <path d="M20 4l-9 9" />
    <path d="M18 14v6H4V6h6" />
  </svg>
  <span class="tip" aria-hidden="true">{label}</span>
</a>

<style>
  .full {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    text-decoration: none;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .full:hover, .full:focus-visible { border-color: currentColor; }
  .tip {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    z-index: 2;
    padding: 0.375rem 0.625rem;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur) var(--ease), visibility 0s var(--dur);
  }
  .full:hover .tip, .full:focus-visible .tip { opacity: 1; visibility: visible; transition-delay: 0s; }
  @media (prefers-reduced-motion: reduce) { .tip { transition: none; } }
</style>
