{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // No per-version preview URLs: only the one production URL can receive messages.
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Sites allowed to post (CORS + Turnstile hostname check). Comma-separated origins.
    "ALLOWED_ORIGINS": "https://crackedontiti.dev"
  },
  // Per-IP limit. Cloudflare's rate limiter is per location and approximate; Turnstile is the main gate.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ]
  // Secrets (never in this file): TURNSTILE_SECRET, NTFY_TOPIC_URL, and optionally NTFY_TOKEN.
  // Without NTFY_TOKEN the topic URL is the only secret: use a long random topic name.
  // Set with `npx wrangler secret put <NAME>`; for `wrangler dev`, put them in .dev.vars (gitignored).
}
