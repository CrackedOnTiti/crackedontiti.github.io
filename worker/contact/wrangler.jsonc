{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // No per-version preview URLs: only the one production URL can receive messages.
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Sites allowed to post (CORS + Turnstile hostname check). Comma-separated origins.
    "ALLOWED_ORIGINS": "https://crackedontiti.dev",
    // Full sender on the Resend-verified domain (crackedontiti.com). Not secret.
    // The recipient (CONTACT_TO) is a secret.
    "CONTACT_FROM": "Portfolio contact <contact@crackedontiti.com>"
  },
  // Per-IP limit. Cloudflare's rate limiter is per location and approximate; Turnstile is the main gate.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ]
  // Secrets (never in this file): TURNSTILE_SECRET, plus at least one delivery channel:
  //   email: RESEND_API_KEY + CONTACT_TO
  //   push:  NTFY_TOPIC_URL (+ optional NTFY_TOKEN; without it, use a long random topic name)
  // Both channels are tried; a message counts as sent if at least one delivers.
  // Set with `npx wrangler secret put <NAME>`; for `wrangler dev`, put them in .dev.vars (gitignored).
}
