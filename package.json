{
  "name": "crackedontiti-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "stats": "node scripts/fetch-github-stats.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "og": "${CHROME:-google-chrome-stable} --headless=new --disable-gpu --hide-scrollbars --allow-file-access-from-files --window-size=1200,630 --screenshot=public/og.png \"file://$PWD/scripts/og/og.html\"",
    "build:redirect": "node scripts/build-redirect.mjs dist redirect"
  },
  "dependencies": {
