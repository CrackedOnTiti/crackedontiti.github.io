  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@types/node": "^26.6.6",
    "simple-icons": "^16.37.0",
    "typescript": "^6.0.3",
    "wrangler": "4.158.0"
  }
