# Copy to .env for local development. Neither value is secret.
# Worker URL (wrangler dev serves on 8787). In CI, set repo variables CONTACT_ENDPOINT and TURNSTILE_SITE_KEY.
PUBLIC_CONTACT_ENDPOINT=http://localhost:8787
# Cloudflare test key that always passes. Use the real site key in CI.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Canonical origin (default https://crackedontiti.dev)
# SITE_URL=https://crackedontiti.dev
